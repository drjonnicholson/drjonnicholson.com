{
  "name": "drjonnicholson.github.io",
  "description": "Jon Nicholson's personal sites,including list of publications.",
  "type": "module",
  "version": "1.0.0",
  "author": "Dr Jon Nicholson (https://www.drjonnnicholson.com)",
  "homepage": "https://www.drjonnicholson.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drjonnicholson/drjonnicholson.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/drjonnicholson/drjonnicholson.github.io/issues"
  },
  "keywords": [
    "Jon Nicholson",
    "portfolio",
    "publications",
    "research"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync": "astro sync",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint --type-aware",
    "lint:styles": "node scripts/check-style-architecture.mjs",
    "test:markdown": "node --experimental-strip-types --test tests/markdown-plugins.test.ts",
    "routine": "npm run lint && npm run lint:styles && npm run test:markdown && npm run sync && npm run format",
    "clean": "rm -rf dist/ .astro/ node_modules/.astro/data-store.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/sitemap": "^3.7.4",
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@date-fns/tz": "^1.5.0",
    "@digi4care/astro-google-tagmanager": "^2.1.0",
    "@expressive-code/plugin-collapsible-sections": "^0.42.0",
    "@expressive-code/plugin-line-numbers": "^0.42.0",
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/bxl": "^1.2.4",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify/utils": "^3.1.7",
    "astro": "^7.4.4",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "hast-util-select": "^6.0.4",
    "hast-util-to-html": "^9.0.6",
    "hastscript": "^9.0.3",
    "husky": "^9.1.7",
    "satori": "^0.63.2",
    "satteri": "^0.10.5",
    "satteri-expressive-code": "^0.1.31",
    "temml": "^0.14.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "mdast-util-to-hast": "^13.2.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sharp": "^0.35.5"
  }
}
