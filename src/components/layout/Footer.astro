---
import { PROFILE, SITE } from "@site-config"
import Icon from "@/components/base/Icon.astro"
import Link from "@/components/base/Link.astro"
import ProfileLinks from "@/components/profile/ProfileLinks.astro"
import { getProfileLinkPlacement } from "@/components/profile/helper"

const footerLinks = getProfileLinkPlacement("footer")
---

<footer>
  <div class="footer-inner">
    <ProfileLinks links={PROFILE.links} keys={footerLinks} />

    <p>
      &copy; <span id="current-year"></span>
      {PROFILE.name}.
      {SITE.license ? (
        <>
          {` Unless otherwise stated, all content is licensed under `}
          <Link class="footer-link" href={SITE.license.href} external>
            {SITE.license.label}.
          </Link>
        </>
      ) : (
        ` All rights reserved.`
      )}
    </p>

    {PROFILE.location && (
      <p class="footer-location">
        <Icon name="mingcute:location-line" />
        <span>{PROFILE.location}</span>
      </p>
    )}

    <p>
      Built with{" "}
      <Link href="https://astro.build/" class="footer-link" external> Astro. </Link>
      View
      <Link href={SITE.sourceCode} class="footer-link" external> Source Code </Link>
      and
      <Link href="/palette" class="footer-link"> Colour Palette. </Link>
    </p>
  </div>
</footer>

<script>
  const yearElement = document.getElementById("current-year")
  if (yearElement) yearElement.textContent = new Date().getFullYear().toString()
</script>

<style>
  footer {
    position: relative;
    margin-block-start: var(--space-l);
    padding-block: var(--space-s);
    border-block-start: 1px solid color-mix(in oklab, var(--foreground) 20%, transparent);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .footer-small {
    font-size: var(--step--1);
  }

  .footer-location {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .footer-link {
    color: var(--foreground);
  }

  .footer-muted-link {
    color: var(--muted-foreground);
  }
</style>
